#theme = "moonfly"
#theme = "oneokai-paper"
theme = "oneokai-idea-dark"
#theme = "oneokai"
#theme = "zenbones"
#font-family = "JetBrainsMonoNL NF Regular"
#font-family = "CaskaydiaMono NF Regular"
font-family = "ComicShannsMono Nerd Font Mono"

command = "~/.config/ghostty/os_spec.bash"

# left option sends alt for nvim/tmux shortcuts, right option still types { } [ ] @ etc. (ignored on linux)
macos-option-as-alt = left

keybind = ctrl+shift+r=reload_config
keybind = f11=toggle_fullscreen
